# Claude API 키 (총괄 AI 분석용) - https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-...

# 분석 모델 (기본 유지 권장. 품질 우선이면 claude-opus-4-8 등으로 변경)
AI_TEAM_MODEL=claude-sonnet-4-6

# ZIANTGYM+ 데이터베이스 (Neon/Postgres) 연결 문자열.
# 없으면 샘플 데이터로 동작하며, 실제 분석을 원하면 넣으세요.
DATABASE_URL=

# 총괄 AI가 자동 분석을 도는 시간 (cron 형식). 기본: 매일 09:00
DAILY_CRON=0 9 * * *

# ── Notion 연동 (선택) ──
# https://www.notion.so/my-integrations 에서 "새 통합 만들기" → 토큰(secret_...) 복사
# 브리핑을 저장할 Notion 데이터베이스를 만든 뒤, 그 페이지 우측 상단 "연결 추가"에서
# 방금 만든 통합을 추가해야 함 (안 하면 권한 오류남)
NOTION_API_KEY=
# 데이터베이스 페이지 URL의 32자리 값 (예: notion.so/xxxx?v=... 에서 xxxx 부분)
NOTION_DATABASE_ID=

# ── 카카오톡 "나에게 보내기" 연동 (선택) ──
# 1) https://developers.kakao.com → 내 애플리케이션 → 앱 만들기
# 2) 앱 키에서 REST API 키 복사 → 아래 KAKAO_REST_API_KEY에 붙여넣기
# 3) 카카오 로그인 → 활성화 ON, Redirect URI에 http://localhost:9325/kakao/callback 등록
# 4) 카카오 로그인 → 동의항목에서 "카카오톡 메시지 전송"(talk_message) 활성화
# 5) npm run kakao-auth 실행 → 브라우저에서 로그인/동의 → 터미널에 나오는 값을 아래에 저장
KAKAO_REST_API_KEY=
KAKAO_REFRESH_TOKEN=
