DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=trainer_app
# ─── 앱별 독립 세션 시크릿 ───────────────────────────────────────────────────
# 각 앱이 완전히 분리된 세션 쿠키(ziantgym.sid / gymplus.sid / fitstep.sid / fittrainer.sid)를 사용합니다.
# 미설정 시 SESSION_SECRET으로 대체되지만, 프로덕션에서는 각각 별도 값을 권장합니다.
SESSION_SECRET=your_session_secret_here
GYMPLUS_SESSION_SECRET=your_gymplus_session_secret_here
FITSTEP_SESSION_SECRET=your_fitstep_session_secret_here
FITTRAINER_SESSION_SECRET=your_fittrainer_session_secret_here

PORT=3000
NODE_ENV=development
# ZIANTGYM+ 회원앱 어드민 URL (설정 시 KPI 대시보드 상단에 연결 버튼 표시)
VITE_GYMPLUS_URL=
